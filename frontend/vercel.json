{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE_WITH_BACKEND_URL/api/:path*" },
    { "source": "/ml/:path*", "destination": "https://REPLACE_WITH_ML_URL/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
